{
  "info": {
    "name": "SmartDesk · Three-role walkthrough",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "demoPassword",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Sign in as employee",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"employee@smartdesk.test\",\n  \"password\": \"{{demoPassword}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Request succeeds', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('employeeToken', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Sign in as engineer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"engineer@smartdesk.test\",\n  \"password\": \"{{demoPassword}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Request succeeds', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('engineerToken', pm.response.json().token);",
              "pm.collectionVariables.set('engineerId',pm.response.json().user.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Sign in as admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@smartdesk.test\",\n  \"password\": \"{{demoPassword}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Request succeeds', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('adminToken', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Read catalog",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{employeeToken}}"
          }
        ],
        "url": "{{baseUrl}}/catalog"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Request succeeds', () => pm.response.to.have.status(200));",
              "const c = pm.response.json();",
              "pm.collectionVariables.set('categoryId',c.categories[0].id);",
              "pm.collectionVariables.set('priorityId',c.priorities[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Open a ticket",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{employeeToken}}"
          }
        ],
        "url": "{{baseUrl}}/tickets",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"VPN session interrupted\",\n  \"description\": \"The client disconnects when switching networks.\",\n  \"categoryId\": {{categoryId}},\n  \"priorityId\": {{priorityId}}\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Request succeeds', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('ticketId',pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Assign ticket",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/tickets/{{ticketId}}/assign",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"engineerId\": {{engineerId}}\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Request succeeds', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Begin investigation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{engineerToken}}"
          }
        ],
        "url": "{{baseUrl}}/tickets/{{ticketId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Request succeeds', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Send response",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{engineerToken}}"
          }
        ],
        "url": "{{baseUrl}}/tickets/{{ticketId}}/comments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"Checking the VPN configuration.\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Request succeeds', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Record resolution",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{engineerToken}}"
          }
        ],
        "url": "{{baseUrl}}/tickets/{{ticketId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"RESOLVED\",\n  \"note\": \"Reissued VPN configuration.\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Request succeeds', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Confirm closure",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{employeeToken}}"
          }
        ],
        "url": "{{baseUrl}}/tickets/{{ticketId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"CLOSED\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Request succeeds', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Inspect ticket history",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{employeeToken}}"
          }
        ],
        "url": "{{baseUrl}}/tickets/{{ticketId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Request succeeds', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Export report",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/reports/tickets.csv"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Request succeeds', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}
