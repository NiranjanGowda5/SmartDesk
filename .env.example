# Optional overrides. Copy to .env. The scripts create independent random
# credentials in .env.local when values aren't supplied. Shell values win.
SPRING_PROFILES_ACTIVE=demo
# JWT_SECRET=base64-encoded-32-or-more-random-bytes
# DEMO_PASSWORD=choose-your-own-unique-demo-password
# For an existing MySQL schema, supply connection details and run
# .\scripts\Start-App.ps1 -Database mysql.
# DB_URL=jdbc:mysql://127.0.0.1:3306/smartdesk
# DB_USER=smartdesk_app
# DB_PASSWORD=your-local-database-password
# JAVA_HOME=C:\Program Files\Java\jdk-21
# MAVEN_HOME=C:\tools\apache-maven-3.9.16
# MYSQL_HOME=C:\Program Files\MySQL\MySQL Server 8.4
